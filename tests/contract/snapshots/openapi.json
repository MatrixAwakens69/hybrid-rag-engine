{
  "components": {
    "schemas": {
      "DependencyHealth": {
        "additionalProperties": false,
        "description": "Safe readiness state for one required dependency.",
        "properties": {
          "latency_ms": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latency Ms"
          },
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          }
        },
        "required": [
          "status"
        ],
        "title": "DependencyHealth",
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "description": "Stable public error body.",
        "properties": {
          "code": {
            "maxLength": 64,
            "minLength": 3,
            "pattern": "^[a-z0-9_]+$",
            "title": "Code",
            "type": "string"
          },
          "field_violations": {
            "items": {
              "$ref": "#/components/schemas/FieldViolation"
            },
            "maxItems": 32,
            "title": "Field Violations",
            "type": "array"
          },
          "message": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "title": "Request Id",
            "type": "string"
          },
          "retryable": {
            "default": false,
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "description": "Versioned error envelope.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          },
          "schema_version": {
            "default": "v1",
            "pattern": "^v1$",
            "title": "Schema Version",
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "FieldViolation": {
        "additionalProperties": false,
        "description": "Bounded validation detail safe to return to a caller.",
        "properties": {
          "field": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Field",
            "type": "string"
          },
          "message": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "field",
          "message"
        ],
        "title": "FieldViolation",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "description": "Liveness or readiness response.",
        "properties": {
          "dependencies": {
            "additionalProperties": {
              "$ref": "#/components/schemas/DependencyHealth"
            },
            "maxProperties": 16,
            "title": "Dependencies",
            "type": "object"
          },
          "revision": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Revision",
            "type": "string"
          },
          "schema_version": {
            "default": "v1",
            "pattern": "^v1$",
            "title": "Schema Version",
            "type": "string"
          },
          "service": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Service",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          }
        },
        "required": [
          "status",
          "service",
          "revision"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "HealthStatus": {
        "description": "Service health states.",
        "enum": [
          "ok",
          "not_ready"
        ],
        "title": "HealthStatus",
        "type": "string"
      }
    }
  },
  "info": {
    "description": "Tenant-safe hybrid document retrieval and grounded answers.",
    "title": "Hybrid RAG Engine API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health/live": {
      "get": {
        "description": "Report only process and event-loop liveness.",
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Live",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "description": "Report configuration and Qdrant connectivity without model calls.",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Ready",
        "tags": [
          "health"
        ]
      }
    }
  }
}
