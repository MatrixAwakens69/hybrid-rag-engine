# Service
HRE_ENVIRONMENT=development
HRE_LOG_LEVEL=INFO
HRE_APP_REVISION=local
HRE_CORS_ORIGINS=["http://localhost:3000"]

# Qdrant
HRE_QDRANT_URL=http://qdrant:6333
HRE_QDRANT_TIMEOUT_SECONDS=5
HRE_QDRANT_COLLECTION_ALIAS=hybrid_chunks_current

# Persistent paths (container defaults)
HRE_SOURCE_VOLUME_PATH=/data/sources
HRE_JOB_MANIFEST_PATH=/data/jobs
HRE_QUARANTINE_PATH=/data/quarantine

# Provider-neutral model adapter configuration. Pin production revisions.
HRE_DENSE_ADAPTER=not-configured
HRE_DENSE_MODEL_REVISION=not-configured
HRE_SPARSE_ADAPTER=not-configured
HRE_SPARSE_MODEL_REVISION=not-configured
HRE_RERANKER_ADAPTER=not-configured
HRE_RERANKER_MODEL_REVISION=not-configured
HRE_GENERATOR_ADAPTER=not-configured
HRE_GENERATOR_MODEL_REVISION=not-configured
HRE_JUDGE_ADAPTER=not-configured
HRE_JUDGE_MODEL_REVISION=not-configured

# Retrieval
HRE_DENSE_CANDIDATES=50
HRE_SPARSE_CANDIDATES=50
HRE_RRF_K=60
HRE_RERANK_TOP_K=20
HRE_EVIDENCE_SCORE_THRESHOLD=0.0

# API and upload bounds
HRE_MAX_UPLOAD_BYTES=52428800
HRE_REQUEST_TIMEOUT_SECONDS=30
HRE_MAX_METADATA_BYTES=16384

# Phase 1 bootstrap authentication. Replace before production.
HRE_BOOTSTRAP_ADMIN_KEY=change-me
